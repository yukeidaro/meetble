# Copy this file to .env and fill in your keys. .env is git-ignored.

# Required: the agent loop (Claude) and browser-use
ANTHROPIC_API_KEY=

# Required: Grok x_search for X posts, replies and 7-day mentions (console.x.ai)
XAI_API_KEY=

# Recommended: Exa web, people, podcast, precedent and event search (dashboard.exa.ai)
# If empty, the app falls back to Exa's keyless public endpoint (free tier, rate-limited).
EXA_API_KEY=

# Optional: Muse Spark (Meta Model API) for public Instagram info (US-only preview)
MODEL_API_KEY=

# Optional: Hunter.io email finder for work-email guess + confidence
HUNTER_API_KEY=

# Optional: the Luma account the run should be signed in as (only used to warn about a wrong account)
LUMA_ACCOUNT=
